{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fun-gutenberg-blocks/card-flip-to-modal-content",
	"version": "0.1.0",
	"title": "Card Flip to Modal Content",
	"category": "widgets",
	"icon": "welcome-widgets-menus",
	"description": "Editable modal content for the Card Flip to Modal block.",
	"parent": [ "fun-gutenberg-blocks/card-flip-to-modal" ],
	"supports": {
		"html": false,
		"reusable": false
	},
	"attributes": {
		"modalSize": {
			"type": "string",
			"enum": [ "small", "medium", "large", "custom" ],
			"default": "medium"
		},
		"customModalWidth": {
			"type": "string",
			"default": "720px"
		}
	},
	"textdomain": "card-flip-to-modal",
	"editorScript": "file:./index.js"
}