{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fun-gutenberg-blocks/card-flip-to-modal-content",
	"version": "0.1.0",
	"title": "Card Flip to Modal Content",
	"category": "widgets",
	"icon": "welcome-widgets-menus",
	"description": "Editable modal content for the Card Flip to Modal block.",
	"parent": [ "fun-gutenberg-blocks/card-flip-to-modal" ],
	"supports": {
		"html": false,
		"reusable": false
	},
	"attributes": {
		"modalSize": {
			"type": "string",
			"enum": [ "small", "medium", "large", "custom" ],
			"default": "medium"
		},
		"customModalWidth": {
			"type": "string",
			"default": "720px"
		},
		"modalBorderRadius": {
			"type": "number",
			"default": 0
		},
		"modalBorderStyle": {
			"type": "string",
			"enum": [ "solid", "dashed", "dotted", "double", "none" ],
			"default": "none"
		},
		"modalBorderColor": {
			"type": "string",
			"default": "#d0d0d0"
		},
		"modalBorderWidth": {
			"type": "number",
			"default": 1
		},
		"modalAriaLabel": {
			"type": "string",
			"default": "Card modal content"
		},
		"modalCloseOnBackdropClick": {
			"type": "boolean",
			"default": false
		},
		"modalShowCloseButton": {
			"type": "boolean",
			"default": true
		},
		"modalLockPageScroll": {
			"type": "boolean",
			"default": true
		},
		"closeButtonText": {
			"type": "string",
			"default": "×"
		},
		"closeButtonAriaLabel": {
			"type": "string",
			"default": "Close modal"
		},
		"closeButtonPosition": {
			"type": "string",
			"enum": [ "top-right", "top-left" ],
			"default": "top-right"
		},
		"closeButtonSize": {
			"type": "number",
			"default": 36
		},
		"closeButtonBackgroundColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"closeButtonTextColor": {
			"type": "string",
			"default": "#111111"
		},
		"closeButtonBorderColor": {
			"type": "string",
			"default": "#d0d0d0"
		},
		"closeButtonBorderRadius": {
			"type": "number",
			"default": 999
		}
	},
	"textdomain": "card-flip-to-modal",
	"editorScript": "file:./index.js"
}