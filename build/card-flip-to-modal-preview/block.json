{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fun-gutenberg-blocks/card-flip-to-modal-preview",
  "version": "0.1.0",
  "title": "Card Flip to Modal Preview",
  "category": "widgets",
  "icon": "format-image",
  "description": "Editable preview card content for the Card Flip to Modal block.",
  "parent": [
    "fun-gutenberg-blocks/card-flip-to-modal"
  ],
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "previewMinHeight": {
      "type": "number",
      "default": 220
    },
    "previewHasShadow": {
      "type": "boolean",
      "default": true
    },
    "previewHasHoverLift": {
      "type": "boolean",
      "default": true
    },
    "previewBackgroundColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "previewBorderColor": {
      "type": "string",
      "default": "#d0d0d0"
    },
    "previewBorderStyle": {
      "type": "string",
      "enum": [
        "solid",
        "dashed",
        "dotted",
        "double",
        "none"
      ],
      "default": "solid"
    },
    "previewBorderRadius": {
      "type": "number",
      "default": 0
    },
    "previewTextColor": {
      "type": "string",
      "default": "#111111"
    }
  },
  "textdomain": "card-flip-to-modal",
  "editorScript": "file:./index.js"
}